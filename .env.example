# Runtime paths and bounded query settings
SOGAVKG_DATABASE_PATH=backend/data/lab.db
SOGAVKG_MAPPING_DIR=semantic/mappings
SOGAVKG_PUBLIC_DEFAULT_FIELDS=["asset_code","name","quantity","status","category","location"]
SOGAVKG_DEFAULT_LIMIT=20
SOGAVKG_MAXIMUM_LIMIT=100
SOGAVKG_PLANNING_MAX_CALLS=2
SOGAVKG_PLANNING_DEADLINE_SECONDS=15
SOGAVKG_ANSWER_MAX_CALLS=2
SOGAVKG_ANSWER_DEADLINE_SECONDS=15

# OpenAI-compatible endpoint. The real secret must be supplied by the process environment.
SOGAVKG_MODEL_BASE_URL=https://api.openai.com/v1
SOGAVKG_MODEL_NAME=gpt-4.1-mini
SOGAVKG_MODEL_API_KEY=
SOGAVKG_HOST=127.0.0.1
SOGAVKG_PORT=8000
