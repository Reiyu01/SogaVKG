MY_MODEL_BASE_URL=http://localhost:8001/v1
MY_MODEL_NAME=
MY_MODEL_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Optional default for the legacy one-click ingestion endpoint. The Builder
# can instead receive a SQLite path while discovering a schema.
SQLITE_DB_PATH=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_SPREADSHEET_ID=xxxxxxxxxxxxxxxx
GOOGLE_CREDENTIALS_PATH=credentials/service-account.json
